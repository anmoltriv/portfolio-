# Public URL of the chat backend (the service in ./backend, deployed separately).
# Vite inlines this at build time, so it must also be set in the hosting
# provider's environment variables — a local .env alone will not affect deploys.
# Leave unset while developing to fall back to http://localhost:3001.
VITE_API_URL=https://your-backend.onrender.com

# Optional. The heatmap reads the public GitHub contribution graph with no token.
# Set GITHUB_TOKEN on the host that serves /api/github-contributions (Vercel or
# the backend) to also merge private contributions. Username defaults to anmoltriv.
# GITHUB_TOKEN=
# GITHUB_USERNAME=anmoltriv
